# ==============================================================================
# SAWITKITA — SISTEM MANAJEMEN KOPERASI KELAPA SAWIT
# Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# Untuk development lokal, jika tidak terhubung PostgreSQL eksternal, sistem
# SawitKita secara otomatis menggunakan local dual-mode engine berbasis JSON 
# terisolasi di prisma/local-dev-db.json sehingga siap jalan seketika tanpa error.
#
# Untuk Production (Supabase / Neon / AWS RDS / Vercel Postgres):
# Gunakan Transaction Pooler (port 6543) untuk DATABASE_URL di Next.js serverless,
# dan Session Pooler / Direct connection (port 5432) untuk DIRECT_URL (migrasi Prisma).
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. SUPABASE API (Opsional untuk storage berkas / auth pihak ketiga)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ------------------------------------------------------------------------------
# 3. AUTENTIKASI & KEAMANAN
# ------------------------------------------------------------------------------
# Kunci rahasia untuk menandatangani JWT session cookie 'sawitkita_session' (minimal 32 karakter).
JWT_SECRET="sawitkita-ultra-secure-jwt-production-secret-key-32chars-min"

# URL dasar aplikasi
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 4. DEFAULT INITIAL SUPER ADMIN (Untuk setup awal seeder aman)
# ------------------------------------------------------------------------------
INITIAL_SUPER_ADMIN_EMAIL="superadmin@sawitkita.co.id"
INITIAL_SUPER_ADMIN_PASSWORD="SawitKitaSecure2026!#"
