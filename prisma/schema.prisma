// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  ANGGOTA
}

enum MemberStatus {
  AKTIF
  NONAKTIF
  PENDING
}

enum FarmStatus {
  PRODUKTIF
  PEREMAJAAN
  NONAKTIF
}

enum PriceStatus {
  AKTIF
  TERJADWAL
  KEDALUWARSA
}

enum TransactionStatus {
  DRAFT
  MENUNGGU_VERIFIKASI
  TERKONFIRMASI
  SIAP_DIBAYAR
  DIBAYAR_SEBAGIAN
  LUNAS
  DIBATALKAN
}

enum PaymentMethod {
  TRANSFER
  TUNAI
}

enum PaymentStatus {
  DRAFT
  DIVERIFIKASI
  DIBATALKAN
}

enum SavingsType {
  SETORAN
  PENARIKAN
  KOREKSI
}

enum SavingsCategory {
  POKOK
  WAJIB
  SUKARELA
}

enum AnnouncementTarget {
  SEMUA
  PENGURUS
  ANGGOTA
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  phone        String?
  passwordHash String
  role         Role      @default(ANGGOTA)
  isActive     Boolean   @default(true)
  avatarUrl    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  member       Member?
  recordedTransactions WeighingTransaction[] @relation("RecordedBy")
  verifiedTransactions WeighingTransaction[] @relation("VerifiedBy")
  createdPayments     Payment[]             @relation("PaymentCreatedBy")
  verifiedPayments    Payment[]             @relation("PaymentVerifiedBy")
  announcements       Announcement[]
  auditLogs           AuditLog[]
  expenses            Expense[]

  @@index([email])
  @@index([role])
}

model Member {
  id           String       @id @default(uuid())
  memberNo     String       @unique
  fullName     String
  nik          String?      @unique
  phone        String
  address      String
  joinDate     DateTime     @default(now())
  status       MemberStatus @default(AKTIF)
  
  // Rekening Bank
  bankName     String?
  bankAccount  String?
  bankHolder   String?

  userId       String?      @unique
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  farms        Farm[]
  transactions WeighingTransaction[]
  payments     Payment[]
  savingsAccount SavingsAccount?
  savingsMutations SavingsMutation[]

  @@index([memberNo])
  @@index([fullName])
  @@index([nik])
  @@index([phone])
  @@index([status])
}

model Farm {
  id           String     @id @default(uuid())
  code         String     @unique
  name         String
  memberId     String
  member       Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  
  areaHectares Decimal    @db.Decimal(10, 2)
  village      String     // Desa
  district     String     // Kecamatan
  regency      String     // Kabupaten
  plantingYear Int?       // Tahun Tanam
  status       FarmStatus @default(PRODUKTIF)
  notes        String?

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  transactions WeighingTransaction[]

  @@index([code])
  @@index([memberId])
  @@index([status])
}

model TbsPrice {
  id            String      @id @default(uuid())
  pricePerKg    Decimal     @db.Decimal(12, 2)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  status        PriceStatus @default(AKTIF)
  sourceNotes   String?     // Catatan sumber (Dinas Perkebunan / Rapat Koperasi)
  category      String?     @default("Standar") // Kategori mutu/kualitas
  createdById   String?

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([effectiveFrom])
  @@index([status])
}

model WeighingTransaction {
  id                  String            @id @default(uuid())
  transactionNo       String            @unique
  ticketNo            String?           @unique
  date                DateTime          @default(now())
  
  memberId            String
  member              Member            @relation(fields: [memberId], references: [id])
  
  farmId              String
  farm                Farm              @relation(fields: [farmId], references: [id])

  grossWeight         Decimal           @db.Decimal(12, 2) // Bruto (kg)
  tareWeight          Decimal           @db.Decimal(12, 2) // Tara (kg)
  deductionPercentage Decimal           @default(0) @db.Decimal(5, 2) // Potongan %
  deductionWeightKg   Decimal           @default(0) @db.Decimal(12, 2) // Potongan berat manual (kg)
  netWeight           Decimal           @db.Decimal(12, 2) // Bersih (kg)
  
  pricePerKg          Decimal           @db.Decimal(12, 2) // Harga per kg saat transaksi
  grossAmount         Decimal           @db.Decimal(14, 2) // Nilai kotor = netWeight * pricePerKg
  paidAmount          Decimal           @default(0) @db.Decimal(14, 2) // Jumlah yang telah dibayar
  remainingAmount     Decimal           @db.Decimal(14, 2) // Sisa hak pembayaran

  qualityCategory     String?           @default("Standar")
  notes               String?
  
  recordedById        String?
  recordedBy          User?             @relation("RecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  
  verifiedById        String?
  verifiedBy          User?             @relation("VerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt          DateTime?
  
  cancellationReason  String?
  status              TransactionStatus @default(MENUNGGU_VERIFIKASI)

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  paymentAllocations  PaymentAllocation[]

  @@index([transactionNo])
  @@index([memberId])
  @@index([farmId])
  @@index([date])
  @@index([status])
}

model Payment {
  id            String        @id @default(uuid())
  paymentNo     String        @unique
  memberId      String
  member        Member        @relation(fields: [memberId], references: [id])
  
  paymentDate   DateTime      @default(now())
  totalAmount   Decimal       @db.Decimal(14, 2)
  paymentMethod PaymentMethod @default(TRANSFER)
  bankReference String?       // Nomor referensi transfer bank
  proofUrl      String?       // URL bukti transfer
  status        PaymentStatus @default(DIVERIFIKASI)
  notes         String?

  createdById   String?
  createdBy     User?         @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  
  verifiedById  String?
  verifiedBy    User?         @relation("PaymentVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt    DateTime?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  allocations   PaymentAllocation[]

  @@index([paymentNo])
  @@index([memberId])
  @@index([paymentDate])
  @@index([status])
}

model PaymentAllocation {
  id            String              @id @default(uuid())
  paymentId     String
  payment       Payment             @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  
  transactionId String
  transaction   WeighingTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  
  allocatedAmount Decimal           @db.Decimal(14, 2)
  createdAt       DateTime          @default(now())

  @@index([paymentId])
  @@index([transactionId])
}

model SavingsAccount {
  id               String          @id @default(uuid())
  memberId         String          @unique
  member           Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  
  principalBalance Decimal         @default(0) @db.Decimal(14, 2) // Simpanan Pokok
  mandatoryBalance Decimal         @default(0) @db.Decimal(14, 2) // Simpanan Wajib
  voluntaryBalance Decimal         @default(0) @db.Decimal(14, 2) // Simpanan Sukarela
  totalBalance     Decimal         @default(0) @db.Decimal(14, 2) // Total
  
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  mutations        SavingsMutation[]

  @@index([memberId])
}

model SavingsMutation {
  id               String          @id @default(uuid())
  mutationNo       String          @unique
  savingsAccountId String
  savingsAccount   SavingsAccount  @relation(fields: [savingsAccountId], references: [id], onDelete: Cascade)
  
  memberId         String
  member           Member          @relation(fields: [memberId], references: [id])

  mutationDate     DateTime        @default(now())
  type             SavingsType     // SETORAN, PENARIKAN, KOREKSI
  category         SavingsCategory // POKOK, WAJIB, SUKARELA
  amount           Decimal         @db.Decimal(14, 2)
  balanceAfter     Decimal         @db.Decimal(14, 2)
  referenceNo      String?
  notes            String?
  createdById      String?

  createdAt        DateTime        @default(now())

  @@index([mutationNo])
  @@index([savingsAccountId])
  @@index([memberId])
  @@index([mutationDate])
  @@index([type])
  @@index([category])
}

model Announcement {
  id          String             @id @default(uuid())
  title       String
  content     String             @db.Text
  targetRole  AnnouncementTarget @default(SEMUA)
  isPublished Boolean            @default(true)
  publishedAt DateTime           @default(now())
  expiresAt   DateTime?
  
  authorId    String?
  author      User?              @relation(fields: [authorId], references: [id], onDelete: SetNull)

  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([targetRole])
  @@index([isPublished])
  @@index([publishedAt])
}

model CooperativeSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String   @db.Text
  description String?
  updatedAt   DateTime @updatedAt

  @@index([key])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName  String?
  action    String   // CREATE, UPDATE, DELETE, VERIFY, CANCEL, LOGIN, LOGOUT
  entity    String   // Member, Farm, TbsPrice, Transaction, Payment, Savings, Setting
  entityId  String?
  details   String   @db.Text
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@index([action])
  @@index([createdAt])
}

model Expense {
  id          String   @id @default(uuid())
  expenseNo   String   @unique
  date        DateTime @default(now())
  category    String   // Operasional Kantor, Perawatan Timbangan, Transportasi, Listrik & Air, dsb.
  amount      Decimal  @db.Decimal(14, 2)
  description String
  proofUrl    String?
  
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([expenseNo])
  @@index([date])
  @@index([category])
}
